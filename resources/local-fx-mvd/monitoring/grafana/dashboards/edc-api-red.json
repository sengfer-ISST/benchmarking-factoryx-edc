  "panels": [
    {
      "id": 199,
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "title": "k6 workload outcome \u2014 does the WORKFLOW complete? (needs k6 remote-write)"
    },
    {
      "id": 200,
      "type": "timeseries",
      "title": "Transaction outcome (tx/s) \u2014 THE run verdict",
      "description": "Completed vs failed DSP transactions per second. If 'failed' is non-zero while the HTTP panels below look healthy, the connector's API is fine and its ASYNC WORKFLOW is not. This is the panel the first campaign did not have.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate({__name__=~\"k6_dsp_transactions_succeeded(_total)?\"}[$__rate_interval]))",
          "legendFormat": "succeeded",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate({__name__=~\"k6_dsp_transactions_failed(_total)?\"}[$__rate_interval]))",
          "legendFormat": "failed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 201,
      "type": "timeseries",
      "title": "Failures by phase and reason",
      "description": "dsp_failure_reason, tagged failed_phase (where it died) and failed_reason (terminated_<STATE> = the connector rejected it; timeout_in_<STATE> = the state machine never got to it, i.e. a capacity limit). These two demand different conclusions.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (failed_phase, failed_reason) (rate({__name__=~\"k6_dsp_failure_reason(_total)?\"}[$__rate_interval]))",
          "legendFormat": "{{failed_phase}} / {{failed_reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "id": 202,
      "type": "timeseries",
      "title": "EDR polls per transaction (overload indicator)",
      "description": "edr_polls / attempted transactions. At the default 250 ms interval and 30 s timeout the ceiling is 120 polls: a healthy wait costs single digits, and a value near the ceiling means transactions are timing out rather than completing. Also quantifies the polling observer effect on the consumer Management API.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate({__name__=~\"k6_edr_polls(_total)?\"}[$__rate_interval])) / clamp_min(sum(rate({__name__=~\"k6_dsp_transactions_(succeeded|failed)(_total)?\"}[$__rate_interval])), 0.001)",
          "legendFormat": "edr polls / tx",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate({__name__=~\"k6_negotiation_polls(_total)?\"}[$__rate_interval])) / clamp_min(sum(rate({__name__=~\"k6_dsp_transactions_(succeeded|failed)(_total)?\"}[$__rate_interval])), 0.001)",
          "legendFormat": "negotiation polls / tx",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 203,
      "type": "timeseries",
      "title": "Async phase latency p95 \u2014 time-to-AGREED / time-to-EDR / end-to-end",
      "description": "The RQ4 figure: the two composite waits that no single HTTP request captures, plus the end-to-end transaction. Needs k6 remote-write. If time_to_edr dominates e2e, the transfer/EDR half is the bottleneck \u2014 that is exactly what the 2026-07-29 Factory-X campaign showed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max({__name__=~\"k6_time_to_agreed_p95\"})",
          "legendFormat": "time-to-AGREED p95",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max({__name__=~\"k6_time_to_edr_p95\"})",
          "legendFormat": "time-to-EDR p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max({__name__=~\"k6_e2e_transaction_duration_p95\"})",
          "legendFormat": "end-to-end p95",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0
          }
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "HTTP server \u2014 RED (rate / errors / duration), per route per runtime",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 100,
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Request rate (req/s) per runtime",
      "description": "Throughput per EDC container. sum of http_server_request_duration_seconds_count rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 1,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Error rate per runtime \u2014 real failures vs. benign polling 404",
      "description": "404s on the EDR endpoint are benign in PROPORTION, not in MAGNITUDE: the endpoint 404s while a transfer is starting, so a few per transaction is normal. A 404 rate that dwarfs the success rate means transactions are polling to timeout \u2014 during the first Factory-X campaign this series sat at ~595/s (88% of all traffic) while 'real failures' was flat at zero and every panel looked healthy. Read it against 'EDR polls per transaction' above, never on its own.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 2,
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*real failures.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*benign.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "REAL",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\", http_response_status_code=~\"4..|5..\", http_response_status_code!=\"404\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} \u2014 real failures (5xx / non-404 4xx)"
        },
        {
          "refId": "POLL",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\", http_response_status_code=\"404\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} \u2014 404 not-ready (EDR polling, benign)"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency per endpoint (route)",
      "description": "95th percentile request duration, broken down by runtime + http_route.",
      "datasource": {
